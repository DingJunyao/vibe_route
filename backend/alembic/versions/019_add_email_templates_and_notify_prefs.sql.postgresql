-- 019: 邮件通知系统（email_templates 表 + user_configs 通知开关列；同时收敛 017/018 分叉）
-- PostgreSQL 手动执行脚本（与 alembic upgrade 二选一；与 PostGIS 无关）

CREATE TABLE IF NOT EXISTS email_templates (
    id SERIAL NOT NULL PRIMARY KEY,
    template_key VARCHAR(50) NOT NULL,
    subject VARCHAR(200) NOT NULL,
    body TEXT NOT NULL,
    is_html BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMP WITHOUT TIME ZONE NOT NULL,
    updated_at TIMESTAMP WITHOUT TIME ZONE NOT NULL,
    created_by INTEGER NULL,
    updated_by INTEGER NULL,
    is_valid BOOLEAN NOT NULL DEFAULT TRUE
);
CREATE UNIQUE INDEX IF NOT EXISTS ix_email_templates_template_key ON email_templates (template_key);

ALTER TABLE user_configs ADD COLUMN IF NOT EXISTS notify_recording_completed BOOLEAN NOT NULL DEFAULT FALSE;
ALTER TABLE user_configs ADD COLUMN IF NOT EXISTS notify_recording_failed BOOLEAN NOT NULL DEFAULT FALSE;
