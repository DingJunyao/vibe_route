-- 018: animation_export_tasks 任务化扩展列（录屏任务队列）
-- PostgreSQL 手动执行脚本（与 alembic upgrade 二选一）

ALTER TABLE animation_export_tasks ADD COLUMN IF NOT EXISTS started_at TIMESTAMP NULL;
ALTER TABLE animation_export_tasks ADD COLUMN IF NOT EXISTS finished_at TIMESTAMP NULL;
ALTER TABLE animation_export_tasks ADD COLUMN IF NOT EXISTS params TEXT NULL;
ALTER TABLE animation_export_tasks ADD COLUMN IF NOT EXISTS auth_token TEXT NULL;
