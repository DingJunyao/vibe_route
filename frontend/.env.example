# === 开发服务器配置 ===
# 开发服务器端口与后端地址（vite.config.ts 读取，自定义端口时改这里；
# 后端端口需与 backend/.env 的 APP_PORT 保持一致）
VITE_DEV_PORT=5173
VITE_DEV_BACKEND_URL=http://localhost:8000

# === Docker 部署相关（仅生产容器用，本地开发忽略） ===
# 前端容器内 nginx 反代的后端地址。
# - 分开部署（docker-compose.split.yml）：默认 http://backend:8000（compose 服务名）
# - 统一部署（all-in-one）：默认 http://127.0.0.1:8000（同容器 uvicorn）
# - 脱 compose 裸部署：改成后端实际地址，如 http://10.0.0.5:8000
# 部署时 cp frontend/.env.example frontend/.env 后按需修改
BACKEND_URL=http://backend:8000

# === 内网穿透配置 ===
# 当通过内网穿透域名访问时，需要配置以下变量

# 完整的访问地址（协议 + 域名 + 端口）
# VITE_ORIGIN=https://example.com

# 禁用 HMR（内网穿透环境下 WebSocket 连接不稳定）
VITE_DISABLE_HMR=false

# HMR WebSocket 配置（仅当 VITE_DISABLE_HMR=false 时生效）
# VITE_HMR_HOST=example
# VITE_HMR_PORT=443
# VITE_HMR_PROTOCOL=wss

# 允许的主机列表（逗号分隔）
# VITE_ALLOWED_HOSTS=example.example.com,.example.com
