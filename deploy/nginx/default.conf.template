# WebSocket 升级连接标记（/api/ws/* 实时轨迹用）
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    # 前端静态资源根目录
    root /usr/share/nginx/html;
    index index.html;

    # gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # 上传/请求体大小（GPX 上传、字体上传等，与后端 MAX_UPLOAD_SIZE 对齐）
    client_max_body_size 100m;

    # API 反代到后端（BACKEND_URL 由 entrypoint envsubst 注入）
    # ^~ 提升前缀优先级至正则之上：否则下方 ~* \.(jpg|png|svg|...)$ 会截走
    # /api/.../*.jpg 等带媒体后缀的请求，把它们当前端静态文件去找 → 404。
    # 同时支持 WebSocket 升级（/api/ws/* 实时轨迹推送）。
    location ^~ /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # 长任务支持（轨迹导入、动画导出等耗时接口）
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # WebSocket 必须关缓冲
        proxy_buffering off;
    }

    # 带哈希的静态资源长缓存
    location ~* \.(?:js|css|woff2?|ttf|eot|otf|png|jpg|jpeg|gif|svg|ico|webp|wasm|mp4|webm)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA history 模式兜底：未命中路由回 index.html，避免刷新 404
    location / {
        try_files $uri $uri/ /index.html;
    }
}
